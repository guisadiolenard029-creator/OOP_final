from datetime import date


class Expense:
    def __init__(self, date, amount, category, note=""):
        self._date = date
        self._amount = amount
        self._category = category
        self._note = note

    def get_amount(self):
        return self._amount

    def set_amount(self, amount):
        if amount < 0:
            raise ValueError("Amount cannot be negative.")
        self._amount = amount

    def get_date(self):
        return self._date

    def get_category(self):
        return self._category

    def get_note(self):
        return self._note

    def describe(self):
        return (
            f"{self._date} | "
            f"₱{self._amount:.2f} | "
            f"{self._category} | "
            f"{self._note}"
        )

    def __repr__(self):
        return (
            f"Expense(date={self._date!r}, "
            f"amount={self._amount!r}, "
            f"category={self._category!r}, "
            f"note={self._note!r})"
        )

    def __lt__(self, other):
        if not isinstance(other, Expense):
            return NotImplemented
        return self._amount < other._amount

    def __eq__(self, other):
    
        if not isinstance(other, Expense):
            return NotImplemented
        return (
            self._date == other._date
            and self._amount == other._amount
            and self._category == other._category
            and self._note == other._note
        )
    
    class RecurringExpense:
    def __init__(self, name, amount, frequency):
        self.name = name
        self.amount = amount
        self.frequency = frequency

    def display_expense(self):
        print("Expense:", self.name)
        print("Amount:", self.amount)
        print("Frequency:", self.frequency)


expense = RecurringExpense("Internet Bill", 1500, "Monthly")
expense.display_expense()

class ExpenseTracker:
    """Tracks expenses and computes spending summaries."""

    def __init__(self, owner):
        self._owner = owner
        self._expenses = []

    def add_expense(self, expense):
        """Add an Expense or RecurringExpense to the list."""
        if isinstance(expense, Expense):
            self._expenses.append(expense)

    def get_expenses(self):
        """Return all recorded expenses."""
        return self._expenses

    def total_by_category(self):
        """Return total spent per category."""
        totals = {}
        for exp in self._expenses:
            cat = exp.get_category()
            totals[cat] = totals.get(cat, 0) + exp.get_amount()
        return totals

    def monthly_summary(self, year, month):
        """Return category totals for a specific year and month."""
        summary = {}
        for exp in self._expenses:
            d = exp.get_date()
            if d.year == year and d.month == month:
                cat = exp.get_category()
                summary[cat] = summary.get(cat, 0) + exp.get_amount()
        return summary

    def top_spending(self):
        """Return the highest expense, or None if empty."""
        return max(self._expenses) if self._expenses else None

    def check_budget(self, budget):
        """Check category spending against a Budget object."""
        cat = budget.get_category()
        spent = self.total_by_category().get(cat, 0)
        return {
            "spent": spent,
            "remaining": budget.remaining(spent),
            "is_over": budget.is_over(spent),
        }

    def __len__(self):
        """Return total number of expenses."""
        return len(self._expenses)
